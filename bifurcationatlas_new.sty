% -------------------------------------------------
% REGION SYSTEM CORE (MUST BE EARLY)
% -------------------------------------------------
\tikzset{
  ba/region/.code={
    \gdef\ba@activeregion{#1}%
  }
}

\DeclareFloatingEnvironment[
  fileext=loa,
  listname={List of Bifurcation Atlases},
  name=Bifurcation Atlas,
  placement=htbp
]{bifurcationatlasfloat}
% =========================================================
% ATLAS STATE
% =========================================================
\newif\ifba@inatlas

\def\ba@atlaslabel{}
\let\ba@oldlabel\label

\newcommand{\baRequireAtlas}{%
  \ifba@inatlas\else
    \PackageError{bifurcationatlas}
      {Command used outside bifurcationatlas environment}
      {Wrap it in bifurcationatlas.}
  \fi
}

\NewDocumentEnvironment{bifurcationatlas}{O{}}
{%
  % ======================================================
  % LOCAL SCOPE (replaces hooks completely)
  % ======================================================
  \begingroup

  % ------------------------------------------------------
  % optional user settings
  % ------------------------------------------------------
  \pgfkeys{/ba,#1}

  % ------------------------------------------------------
  % activate atlas
  % ------------------------------------------------------
  \ba@inatlastrue
  \stepcounter{baAtlasID}

  \def\ba@activeregion{}
  % reset counters
  \setcounter{baRegion}{0}
  \setcounter{baSubRegion}{0}

  % reset local storage
  \def\ba@regionlist{}
  \def\ba@colors{}
  \def\ba@caption{}

  % ------------------------------------------------------
  % LABEL CAPTURE (local, safe, no global patching)
  % ------------------------------------------------------
  \let\ba@oldlabel\label
  \gdef\ba@atlaslabel{}

  \renewcommand{\label}[1]{%
    \ifx\ba@atlaslabel\@empty
      \gdef\ba@atlaslabel{##1}%
    \fi
    \ba@oldlabel{##1}%
  }%

  % ------------------------------------------------------
  % OPEN FLOAT (core content container)
  % ------------------------------------------------------
  \begin{bifurcationatlasfloat}
}
{%
  % ------------------------------------------------------
  % CLOSE FLOAT
  % ------------------------------------------------------
  \end{bifurcationatlasfloat}

  % ------------------------------------------------------
  % CLEANUP (automatic via group)
  % ------------------------------------------------------
  \ba@inatlasfalse
  \let\label\ba@oldlabel

  \endgroup
}
% =========================================================
% PGFKEYS
% =========================================================
\pgfkeys{/ba/.is family}
\pgfkeys{/ba/region/.is family, /ba/region}
\pgfkeys{
  /ba/regions scale/.code   = {\renewcommand{\ba@region@scale}{#1}},
  /ba/regions radius/.code  = {\renewcommand{\ba@region@radius}{#1}},
  /ba/caption style/.code  = {\renewcommand{\ba@caption@style}{#1}},
  /ba/figure scale/.code   = {\renewcommand{\ba@figure@scale}{#1}},
  /ba/caption shift/.code  = {\renewcommand{\ba@caption@shift}{#1}},
  %/ba/internal/region colors/.store in=\ba@colors,
  %/ba/internal/region caption/.store in=\ba@caption,
  /ba/caption label/.is choice,
  /ba/caption label/alpha/.code  = {\def\ba@fmtcaption{\alph{baSubRegion}}},
  /ba/caption label/roman/.code  = {\def\ba@fmtcaption{\roman{baSubRegion}}},
  /ba/caption label/Roman/.code  = {\def\ba@fmtcaption{\Roman{baSubRegion}}},
  /ba/caption label/arabic/.code = {\def\ba@fmtcaption{\arabic{baSubRegion}}}
}
\newcommand{\baSetup}[1]{\pgfkeys{/ba,#1}}


% =========================================================
% REGION DECLARATION
% =========================================================
\NewDocumentCommand{\baDeclareRegion}{O{} m m}{%
  \baRequireAtlas

  % store caption
  \expandafter\gdef\csname ba@caption@#2\endcsname{#1}%

  % store region list entry
  \gappto\ba@regionlist{#2,}%

  % parse positional list
  \ba@storepositional{#2}{#3}%
}
\def\ba@storepositional#1#2{%
  \def\ba@region{#1}%
  \@tempcnta=0
  \ifdebug 
	  \typeout{[ba DEBUG] storing region=#1 list=#2}%
  \fi

  \@for\ba@item:=#2\do{%
    \advance\@tempcnta by 1

	\ifdebug
    	\typeout{[ba DEBUG] pos \the\@tempcnta = \ba@item}%
    \fi

    \expandafter\gdef\csname ba@#1@__pos@\the\@tempcnta\endcsname{\ba@item}%

    \ifdebug
	    \typeout{[ba DEBUG] stored ->
	      ba@#1@__pos@\the\@tempcnta = \csname ba@#1@__pos@\the\@tempcnta\endcsname
	    }%
    \fi
  }%
}
