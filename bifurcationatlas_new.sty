% =========================================================
% REGION DATA DEFINITION
% =========================================================

\newcommand{\baDeclareRegionData}[2]{%
  \gappto\ba@regionlist{#1,}%
  \def\ba@region{#1}%
  \@for\ba@item:=#2\do{%
    \expandafter\ba@split\ba@item\relax
  }%
}
\def\ba@split#1=#2\relax{%
  \edef\key{\zap@space#1 \@empty}%
  \edef\value{\zap@space#2 \@empty}%
  \pgfkeys{/ba/region/\ba@region/\key/.initial=none}
  \pgfkeys{/ba/region/\ba@region/\key=\value}%
}

