% =========================================================
% RENDERING
% =========================================================
\newcommand{\baRenderRegion}[2]{%
  \begingroup
  \def\ba@activeregion{#2}%
  \expandafter\let\expandafter\ba@colors
    \csname ba@region@colors@#2\endcsname
  \scalebox{\ba@region@scale}{%
    \begin{tikzpicture}
      \pic{#1};
    \end{tikzpicture}%
  }%
  \endgroup
}
