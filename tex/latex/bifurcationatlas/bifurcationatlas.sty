\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bifurcationatlas}[2026/06/22 v2.0.0 Structured bifurcation diagram toolkit]

% =========================================================
% REQUIRED PACKAGES
% =========================================================
\RequirePackage{tikz}
\RequirePackage{graphicx}
\RequirePackage{pgfkeys}
\RequirePackage{pgffor}
\RequirePackage{newfloat}
\RequirePackage{ifthen}

% =========================================================
% COUNTERS AND BASIC FORMATTING
% =========================================================
\newcounter{bafigure}
\newcounter{basubfigure}[bafigure]

\renewcommand{\thebafigure}{\arabic{bafigure}}
\renewcommand{\thebasubfigure}{\baGetLabelFormat{basubfigure}}
\renewcommand{\p@bafigure}{Atlas~}
\renewcommand{\p@basubfigure}{\thebafigure.}
\newcommand{\basubcaptionformat}{(\thebasubfigure)}
\newcommand{\subref}[1]{%
  \ref{sub@#1}%
}


% Transparent placeholder color
\colorlet{transparent}{white!0}

% Package switches
\newif\ifba@debug
\ba@debugfalse

% =========================================================
% GLOBAL STATE
% =========================================================
\def\ba@atlas@list{}
\def\ba@path@region{/ba/\ba@atlas@current/region}

% =========================================================
% HELPER UTILITIES
% =========================================================

% Append an item to a comma-separated macro list
\newcommand{\appendtolist}[2]{%
  \ifx#1\@empty
    \edef#1{#2}%
  \else
    \edef#1{#1,#2}%
  \fi
}

% Check whether #1 is contained in comma list #2
\def\incommalist#1#2#3#4{%
  \def\in@result{0}%
  \def\in@needle{#1}%
  \@for\in@item:=#2\do{%
    \ifthenelse{\equal{\in@item}{\in@needle}}{%
      \def\in@result{1}%
    }{}%
  }%
  \ifthenelse{\equal{\in@result}{1}}{%
    #3%
  }{%
    #4%
  }%
}

% Floating environment for atlas figures
\DeclareFloatingEnvironment[
  fileext=loa,
  listname={List of Bifurcation Atlases},
  name=Bifurcation Atlas,
  placement=htbp
]{bifurcationatlasfloat}

% Writes the subcaption entry into the .aux file for later use by \subref.
\newcommand{\ba@writesublabel}[1]{%
  \begingroup
  \edef\ba@tmp{#1}%
  \if\relax\detokenize\expandafter{\ba@tmp}\relax
    % empty → do nothing
  \else
    \protected@write\@auxout{}{%
      \string\newlabel{sub@#1}{{\thebasubfigure}{\thepage}}%
    }%
  \fi
  \endgroup
}

% =========================================================
% ATLAS STATE
% =========================================================
\newif\ifba@inatlas

\newcommand{\baRequireAtlas}{%
  \ifba@inatlas\else
    \PackageError{bifurcationatlas}
      {Command used outside bifurcationatlas environment}
      {Wrap it in bifurcationatlas.}
  \fi
}

% =========================================================
% BIFURCATION ATLAS ENVIRONMENT
% =========================================================
% Purpose:
% - Wraps a floating environment
% - Manages figure/subfigure counters
% - Applies user configuration via PGF keys
% - Establishes local atlas scope
% =========================================================
\NewDocumentEnvironment{bifurcationatlas}{O{}}
{%
  \begingroup

  \baSetup{#1}

  % activate atlas
  \ba@inatlastrue
  \stepcounter{basubfigure}

  % ------------------------------------------------------
  % FIX 1: IMMUTABLE ATLAS BASE (core correction)
  % ------------------------------------------------------
  \edef\ba@atlasbase{ba@\thebafigure}%

  % reset counters
  \setcounter{basubfigure}{0}

  \begin{bifurcationatlasfloat}
  \refstepcounter{bafigure}

}
{%
  \end{bifurcationatlasfloat}
  \ba@inatlasfalse

  \endgroup
}

% =========================================================
% PGFKEYS
% =========================================================

% ---------------------------------------------------------
% ROOT
% ---------------------------------------------------------
\pgfkeys{
  /ba/.is family,
  /ba,
}

% ---------------------------------------------------------
% INPUT (temporary user-provided data)
% ---------------------------------------------------------
\pgfkeys{
  /ba/input/.is family,
  /ba/input,
  body/.initial={},
  caption/.initial={},
  label/.initial={}
}

% ---------------------------------------------------------
% CORE DEFAULTS (global fallback values)
% ---------------------------------------------------------
\pgfkeys{
  /ba/core/atlas/.is family,
  /ba/core/atlas,
  scale/.initial=1,
}

\pgfkeys{
  /ba/core/region/.is family,
  /ba/core/region,
  scale/.initial=1,
  radius/.initial=6,
}

\pgfkeys{
  /ba/core/caption/.is family,
  /ba/core/caption,
  size/.initial=\normalsize,
  shift/.initial=0pt,
  label-format/.initial=arabic,
}

% ---------------------------------------------------------
% CONFIG (user interface → writes into core/state)
% ---------------------------------------------------------
\pgfkeys{
  /ba/config/.is family,
  /ba/config,
  debug/.is if=ba@debug,
  region scale/.code={
    \pgfkeys{/ba/core/region/scale=#1}%
  },
  region radius/.code={
    \pgfkeys{/ba/core/region/radius=#1}%
  },
  figure scale/.code={
    \pgfkeys{/ba/core/atlas/scale=#1}%
  },
  caption style/.code={
    \pgfkeys{/ba/core/caption/size=#1}%
  },
  caption shift/.code={
    \pgfkeys{/ba/core/caption/shift=#1}%
  },
  caption label/.code={
    \pgfkeys{/ba/core/caption/label-format=#1}%
  },
}

\newcommand{\baSetup}[1]{%
  \pgfkeys{/ba/config,#1}%
}

% =========================================================
% ATLAS CORE LOGIC
% =========================================================

% Set current atlas and compute base region path
\newcommand{\setAtlas}[1]{\ba@setAtlas{#1}}
\def\ba@setAtlas#1{%
  \def\ba@atlas@current{#1}%
  \edef\ba@path@region{/ba/#1/region}%
}

% Check whether current atlas exists
\newcommand{\baCheckAtlas}{%
  \incommalist{\ba@atlas@current}{\ba@atlas@list}{%
    % OK: atlas exists
  }{%
    \PackageError{bifurcationatlas}
      {Unknown atlas `\ba@atlas@current`}
      {The atlas is not in \ba@atlas@list. Did you call \string\InitAtlas?}%
  }%
}

% Register a new atlas and store its template data
\newcommand{\initAtlas}[3]{%
  \appendtolist{\ba@atlas@list}{#1}%
  \pgfkeys{/ba/.cd,
    #1/region/variables/.initial={},
    #1/region/body/.initial={},
    #1/region/variables={#2},
    #1/region/body={#3}
  }%
  \pgfkeys{/ba/#1/region/.is family}%
}

% =========================================================
% REGION LOGIC
% =========================================================

% Initialize a region entry and per-variable color slots
\newcommand{\baInitRegion}[1]{%
  \pgfkeys{\ba@path@region/.cd,
    #1/caption/.initial={},
    #1/label/.initial={}
  }%
  \edef\ba@list{%
    \pgfkeysvalueof{\ba@path@region/variables}%
  }%
  \@for\ba@tmp:=\ba@list\do{%
    \pgfkeys{\ba@path@region/#1/color/\ba@tmp/.initial=transparent}%
  }%
}

% Parse and store a comma-separated list of key=value color assignments
\newcommand{\baCompileRegionColors}[2]{%
  \edef\ba@list{#2}%
  \@for\ba@pair:=\ba@list\do{%
    \expandafter\ba@setcolorpair\ba@pair\relax{#1}{\ba@path@region}%
  }%
}

% Split a key=value pair and store it in the region color tree
\def\ba@setcolorpair#1=#2\relax#3#4{%
  \pgfkeys{#4/#3/color/#1={#2}}%
}

% =========================================================
% PUBLIC API: REGION INPUT PIPELINE
% =========================================================

\NewDocumentCommand{\baNewRegion}{O{} O{} m m}{%
  \baRequireAtlas

  % Set atlas context if one is explicitly provided
  \if\relax\detokenize{#2}\relax
    % No atlas given: keep current atlas
  \else
    % Atlas given: switch to it
    \ba@setAtlas{#2}%
  \fi

  % Sanity check
  \baCheckAtlas

  % Temporary metadata input
  \pgfkeys{/ba/input/.cd,#1}%

  % Region name
  \def\ba@currentRegion{#3}%

  % Create the region structure
  \baInitRegion{\ba@currentRegion}%

  % Store color assignments
  \baCompileRegionColors{\ba@currentRegion}{#4}%

  % Store metadata for the region
  \pgfkeys{\ba@path@region/.cd,
    #3/caption/.expanded=\pgfkeysvalueof{/ba/input/caption},
    #3/label/.expanded=\pgfkeysvalueof{/ba/input/label}
  }%
}

% =========================================================
% ACCESSORS
% =========================================================

\newcommand{\baRegionColor}[2]{%
  \pgfkeysvalueof{\ba@path@region/#1/color/#2}%
}

\newcommand{\baRegionCaption}[1]{%
  \pgfkeysvalueof{\ba@path@region/#1/caption}%
}

\newcommand{\baRegionLabel}[1]{%
  \pgfkeysvalueof{\ba@path@region/#1/label}%
}

\newcommand{\baAtlasTemplate}{%
  \pgfkeysvalueof{\ba@path@region/body}%
}

\newcommand{\baColor}[1]{\baRegionColor{\ba@currentregion}{#1}}

% =========================================================
% RENDERING
% =========================================================

\newcommand{\baRenderRegion}[1]{%
  \gdef\ba@currentregion{#1}%
  \scalebox{\baGetRegionScale}{%
    \begin{tikzpicture}
      \baAtlasTemplate
    \end{tikzpicture}%
  }%
}

% =========================================================
% REGION SETTINGS
% =========================================================
\newcommand{\baGetRegionScale}{%
  \pgfkeysvalueof{/ba/core/region/scale}%
}

\newcommand{\baGetRegionRadius}{%
  \pgfkeysvalueof{/ba/core/region/radius}%
}

% =========================================================
% ATLAS SETTINGS
% =========================================================
\newcommand{\baGetFigureScale}{%
  \pgfkeysvalueof{/ba/core/atlas/scale}%
}

% =========================================================
% CAPTION SETTINGS
% =========================================================
\newcommand{\baGetCaptionSize}{%
  \pgfkeysvalueof{/ba/core/caption/size}%
}

\newcommand{\baGetCaptionShift}{%
  \pgfkeysvalueof{/ba/core/caption/shift}%
}

\newcommand{\baGetLabelFormat}{%
  \expandafter\csname
    \pgfkeysvalueof{/ba/core/caption/label-format}%
  \endcsname%
}

% =========================================================
% LAYOUT HELPERS
% =========================================================
\newcommand{\baPlaceRadialNode}[3]{%
  \pgfmathsetmacro{\ba@angle}{90-(#1-1)*360/#2}%
  \node at (\ba@angle:\baGetRegionRadius) {#3};
}

% =========================================================
% RADIAL ATLAS RENDERER
% =========================================================
\NewDocumentCommand{\baRadialAtlas}{m}{%
  \baRequireAtlas

  % Determine number of regions
  \foreach \r [count=\i] in {#1}{%
    \xdef\baLastIndex{\i}%
  }%

  % Render all regions in a radial layout
  \foreach \r [count=\i] in {#1}{%
    \refstepcounter{basubfigure}%
    %\ba@setlabel{\baRegionLabel{\r}}%
    \label{\baRegionLabel{\r}}
	\ba@writesublabel{\baRegionLabel{\r}}
	
    \edef\baTmpCaption{\baRegionCaption{\r}}%

    \baPlaceRadialNode{\i}{\baLastIndex}{%
      \begin{tabular}{c}
        \baRenderRegion{\r}\\[2mm]
        \if\relax\detokenize{\baTmpCaption}\relax
        \else
          {\baGetCaptionSize \basubcaptionformat~\baTmpCaption}\\\\
        \fi
      \end{tabular}
    }%
  }%
}

% =========================================================
% ATLAS FIGURE
% =========================================================
\NewDocumentCommand{\baAtlasFigure}{O{} m m}{%
  \baRequireAtlas
  \pgfkeys{/ba/input/.cd,#1}%

  % Store atlas-level caption and label metadata for the center figure
  \pgfkeys{\ba@path@region/.cd,
    center/caption/.initial={},
    center/label/.initial={},
    center/caption/.expanded=\pgfkeysvalueof{/ba/input/caption},
    center/label/.expanded=\pgfkeysvalueof{/ba/input/label}
  }%
  \edef\ba@caption{\pgfkeysvalueof{/ba/input/caption}}%
  \edef\ba@label{\pgfkeysvalueof{/ba/input/label}}%

  \begin{tikzpicture}

    % Background bifurcation diagram
    \node (bg) at (0,0)
      {\includegraphics[scale=\baGetFigureScale]{#2}};

    % Atlas-level label and optional caption
    \refstepcounter{basubfigure}%
    %\ba@setlabel{\ba@label}%
    \label{\ba@label}
    \ba@writesublabel{\ba@label}
    
    \if\relax\detokenize{\ba@caption}\relax\else
      \node[anchor=north]
        at ([yshift=-\baGetCaptionShift]bg.south)
        {\baGetCaptionSize\basubcaptionformat~\ba@caption};
    \fi

    % Radial overlay
    \baRadialAtlas{#3}

  \end{tikzpicture}
}