\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bifurcationatlas}[2026/06/10 v0.1 Structured bifurcation diagram toolkit]

% =========================================================
% 1. DEPENDENCIES
% =========================================================
\RequirePackage{tikz}
\RequirePackage{xparse}
\RequirePackage{graphicx}
\RequirePackage{pgfkeys}
\RequirePackage{pgffor}
\RequirePackage{newfloat}
\RequirePackage{etoolbox}
\RequirePackage{hyperref}

% =========================================================
% 2. GLOBAL DEFAULT PARAMETERS
% =========================================================

% geometry / layout
\newcommand{\ba@region@scale}{1.25}
\newcommand{\ba@region@radius}{6}
\newcommand{\ba@figure@scale}{0.25}
\newcommand{\ba@caption@shift}{-3mm}

% text styling
\newcommand{\ba@caption@style}{\scriptsize}

% caption numbering format
\def\ba@fmtcaption{\alph{baSubRegion}}
\newcommand{\baFormatCaptionLabel}{\ba@fmtcaption}

% atlas label system (user + internal)
\newcommand{\ba@atlaslabel}{}
\def\ba@atlasbase{}

% helper
\newcommand{\basubref}[1]{\ref{sub@#1}}

% =========================================================
% 3. COUNTERS
% =========================================================
\newcounter{baAtlasID}
\newcounter{baRegion}[baAtlasID]
\newcounter{baSubRegion}

\newcount\ba@i
\newcount\ba@j

\renewcommand{\thebaAtlasID}{\arabic{baAtlasID}}
\renewcommand{\thebaRegion}{\arabic{baAtlasID}.\baFormatCaptionLabel}
\renewcommand{\thebaSubRegion}{\baFormatCaptionLabel}

% =========================================================
% 4. FLOAT ENVIRONMENT
% =========================================================
\DeclareFloatingEnvironment[
  fileext=loa,
  listname={List of Bifurcation Atlases},
  name=Bifurcation Atlas,
  placement=htbp
]{bifurcationatlasfloat}

% =========================================================
% 5. STATE FLAGS
% =========================================================
\newif\ifba@inatlas
\newif\ifba@userlabel
\newif\ifba@positional

\let\ba@oldlabel\label

% =========================================================
% 6. ATLAS SAFETY GUARD
% =========================================================
\newcommand{\baRequireAtlas}{%
  \ifba@inatlas\else
    \PackageError{bifurcationatlas}
      {Command used outside bifurcationatlas environment}
      {Wrap it in bifurcationatlas.}
  \fi
}

% =========================================================
% 7. ATLAS ENVIRONMENT
% =========================================================
\NewDocumentEnvironment{bifurcationatlas}{O{}}
{%
  \begingroup

  % user configuration
  \pgfkeys{/ba,#1}

  % activate atlas mode
  \ba@inatlastrue
  \stepcounter{baAtlasID}

  % internal immutable base label
  \edef\ba@atlasbase{ba@\thebaAtlasID}%

  % reset counters
  \setcounter{baRegion}{0}
  \setcounter{baSubRegion}{0}

  % reset internal storage
  \def\ba@regionlist{}
  \def\ba@colors{}
  \def\ba@colornames{}
  \def\ba@caption{}

  % label interception (captures optional user label)
  \ba@userlabelfalse
  \let\ba@atlaslabel\empty

  \let\ba@oldlabel\label
  \renewcommand{\label}[1]{%
    \edef\ba@atlaslabel{##1}%
    \ba@oldlabel{##1}%
  }%

  % open float
  \begin{bifurcationatlasfloat}
}
{%
  % close float
  \end{bifurcationatlasfloat}

  % restore state
  \ba@inatlasfalse
  \let\label\ba@oldlabel

  \endgroup
}

% =========================================================
% 8. PGFKEYS INTERFACE
% =========================================================
\pgfkeys{
  /ba/.is family,
  /ba,
  % layout controls
  region scale/.code   = {\renewcommand{\ba@region@scale}{#1}},
  region radius/.code  = {\renewcommand{\ba@region@radius}{#1}},
  figure scale/.code   = {\renewcommand{\ba@figure@scale}{#1}},
  caption shift/.code  = {\renewcommand{\ba@caption@shift}{#1}},
  caption style/.code  = {\renewcommand{\ba@caption@style}{#1}},
  % internal storage
  internal/region colors/.store in=\ba@colors,
  internal/region colornames/.store in=\ba@colornames,
  internal/region caption/.store in=\ba@caption,
  % caption style selector
  caption label/.is choice,
  /ba/caption label/alpha/.code  = {\def\ba@fmtcaption{\alph{baSubRegion}}},
  /ba/caption label/roman/.code  = {\def\ba@fmtcaption{\roman{baSubRegion}}},
  /ba/caption label/Roman/.code  = {\def\ba@fmtcaption{\Roman{baSubRegion}}},
  /ba/caption label/arabic/.code = {\def\ba@fmtcaption{\arabic{baSubRegion}}}
}

\newcommand{\baSetup}[1]{\pgfkeys{/ba,#1}}

% =========================================================
% 9. REGION DECLARATION
% =========================================================

% ---------------------------------------------------------
% indexed (positional) declaration
% ---------------------------------------------------------
\NewDocumentCommand{\baDeclareRegion}{O{} m m}{%
  \baRequireAtlas
  \ba@positionaltrue

  \gappto\ba@regionlist{#2,}
  \expandafter\gdef\csname ba@caption@#2\endcsname{#1}

  % build index list
  \def\ba@indexlist{}
  \ba@i=0
  \@for\n:=#3\do{%
    \advance\ba@i by 1
    \ifx\ba@indexlist\empty
      \edef\ba@indexlist{\the\ba@i}%
    \else
      \edef\ba@indexlist{\ba@indexlist,\the\ba@i}%
    \fi
  }

  \tikzset{
    ba/region/#2/.style={
      /ba/internal/region colors={#3},
      /ba/internal/region colornames={\ba@indexlist}
    }
  }
}

% ---------------------------------------------------------
% semantic key=value declaration
% ---------------------------------------------------------
\NewDocumentCommand{\baDeclareRegionData}{O{} m m}{%
  \baRequireAtlas
  \ba@positionalfalse

  \gappto\ba@regionlist{#2,}
  \expandafter\gdef\csname ba@caption@#2\endcsname{#1}

  \def\ba@colors{}
  \def\ba@colornames{}

  \@for\ba@pair:=#3\do{%
    \expandafter\ba@splitpair\ba@pair\relax
  }

  \expandafter\tikzset\expandafter{
    ba/region/#2/.style/.expanded={
      /ba/internal/region colors={\ba@colors},
      /ba/internal/region colornames={\ba@colornames}
    }
  }
}

% =========================================================
% 10. INTERNAL PARSING HELPERS
% =========================================================
\def\ba@splitpair#1=#2\relax{%
  \ifx\ba@colors\empty
    \edef\ba@colors{\ba@stripspaces{#2}}%
  \else
    \edef\ba@colors{\ba@colors,\ba@stripspaces{#2}}%
  \fi

  \ifx\ba@colornames\empty
    \edef\ba@colornames{\ba@stripspaces{#1}}%
  \else
    \edef\ba@colornames{\ba@colornames,\ba@stripspaces{#1}}%
  \fi
}

\def\ba@stripspaces#1{\zap@space#1 \@empty}

% =========================================================
% 11. ACCESS HELPERS
% =========================================================
\newcommand{\baGetRegionCaption}[1]{%
  \ifcsname ba@caption@#1\endcsname
    \csname ba@caption@#1\endcsname
  \fi
}

% =========================================================
% 12. COLOR SYSTEM
% =========================================================
\newcommand{\ba@getcolor}[1]{%
  \ifcsname ba@color@#1\endcsname
    \csname ba@color@#1\endcsname
  \else white\fi
}
\newcommand{\baGetColor}[1]{\ba@getcolor{#1}}

% =========================================================
% 13. PIC SYSTEM (CORE RENDERING)
% =========================================================
\newcommand{\baNewPic}[2]{%
  \tikzset{
    #1/.pic={%
      \baPrepareColors
      #2%
    }%
  }%
}

% =========================================================
% 13b. COLOR PREPARATION SYSTEM
% =========================================================
% This system resolves semantic color mappings either
% by positional order or by named identifiers.
% =========================================================

\newcommand{\baPrepareColors}{%
  \ifba@positional
    \baPrepareColorsPosition
  \else
    \baPrepareColorsNames
  \fi
}

% ---------------------------------------------------------
% POSITIONAL COLOR ASSIGNMENT
% (colors mapped by index order)
% ---------------------------------------------------------
\newcommand{\baPrepareColorsPosition}{%
  \let\ba@tmpcolors\ba@colors%
  \let\ba@tmpnames\ba@colornames%

  \ba@i=0

  % iterate over colors
  \edef\ba@tmp{\ba@tmpnames}%

  \@for\c:=\ba@tmpcolors\do{%
    \advance\ba@i by 1%
    \ba@j=1%

    \@for\n:=\ba@tmp\do{%
      \ifnum\ba@j=\ba@i
        \expandafter\xdef\csname ba@color@\n\endcsname{\c}%
      \fi
      \advance\ba@j by 1%
    }%
  }%
}

% ---------------------------------------------------------
% NAME-BASED COLOR ASSIGNMENT
% (colors mapped by semantic names)
% ---------------------------------------------------------
\newcommand{\baPrepareColorsNames}{%
  \let\ba@tmpcolors\ba@colors%
  \let\ba@tmpnames\ba@colornames%

  \ba@i=0%
  \ba@j=0%

  \edef\ba@tmpnamesflat{\ba@tmpnames}%

  \@for\c:=\ba@tmpcolors\do{%
    \advance\ba@i by 1%
    \ba@j=0%

    \@for\n:=\ba@tmpnamesflat\do{%
      \advance\ba@j by 1%

      \ifnum\ba@j=\ba@i
        \expandafter\xdef\csname ba@color@\n\endcsname{\c}%
      \fi
    }%
  }%
}

% =========================================================
% 14. RENDERING ENGINE
% =========================================================
\newcommand{\baRenderRegion}[2]{%
\scalebox{\ba@region@scale}{%
\begin{tikzpicture}
  \pic[ba/region/#2]{#1};
\end{tikzpicture}}%
}

\newcommand{\baPlaceRadialNode}[3]{%
  \pgfmathsetmacro{\ba@angle}{90-(#1-1)*360/#2}%
  \node at (\ba@angle:\ba@region@radius) {#3};
}

% =========================================================
% 15. RADIAL ATLAS RENDERER
% =========================================================
\NewDocumentCommand{\baRadialAtlas}{O{0} m m}{%
\baRequireAtlas

  \foreach \r [count=\i] in {#2}{%
    \xdef\baLastIndex{\i}%
  }

  \foreach \r [count=\i] in {#2}{%
    \refstepcounter{baSubRegion}
    \refstepcounter{baRegion}

    \edef\ba@tmp@label{\ba@atlasbase.\arabic{baRegion}}%
    \label{\ba@tmp@label}%

    \protected@write\@auxout{}{%
      \string\newlabel{sub@\ba@tmp@label}%
      {{\thebaSubRegion}{\thepage}}%
    }

    \edef\baTmpCaption{\baGetRegionCaption{\r}}

    \baPlaceRadialNode{\i}{\baLastIndex}{%
      \begin{tabular}{c}
        \baRenderRegion{#3}{\r}\\[2mm]
        \if\relax\detokenize{\baTmpCaption}\relax\else
          {\ba@caption@style (\baFormatCaptionLabel)~\baTmpCaption}\\\\
        \fi
      \end{tabular}
    }
  }
}

% =========================================================
% 16. HIGH LEVEL FIGURE COMMAND
% =========================================================
\NewDocumentCommand{\baAtlasFigure}{O{} m m m}{%
\baRequireAtlas

\begin{tikzpicture}

  \node (bg) at (0,0)
    {\includegraphics[scale=\ba@figure@scale]{#2}};

  \if\relax\detokenize{#1}\relax
    \def\ba@offset{0}
  \else
    \def\ba@offset{1}

    \refstepcounter{baSubRegion}
    \refstepcounter{baRegion}

    \edef\ba@tmp@label{\ba@atlasbase.\arabic{baRegion}}%
    \label{\ba@tmp@label}%

    \protected@write\@auxout{}{%
      \string\newlabel{sub@\ba@tmp@label}%
      {{\thebaSubRegion}{\thepage}}%
    }

    \node[anchor=north]
      at ([yshift=-\ba@caption@shift]bg.south)
      {\ba@caption@style (\baFormatCaptionLabel)~#1};
  \fi

  \baRadialAtlas[\ba@offset]{#3}{#4}

\end{tikzpicture}
}