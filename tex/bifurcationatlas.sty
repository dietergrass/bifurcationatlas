%  \ifx\ba@caption@label\@empty
%    (\alph{baRegionCaption})%
%  \else\if\ba@caption@label alpha
%    (\alph{baRegionCaption})%
%  \else\if\ba@caption@label roman
%    (\roman{baRegionCaption})%
%  \else\if\ba@caption@label Roman
%    (\Roman{baRegionCaption})%
%  \else\if\ba@caption@label arabic
%    (\arabic{baRegionCaption})%
