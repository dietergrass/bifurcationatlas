\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bifurcationatlas}[2026/06/10 Structured bifurcation diagram toolkit]

% =========================================================
% REQUIRED PACKAGES
% =========================================================
\RequirePackage{tikz}
\RequirePackage{xparse}
\RequirePackage{graphicx}
\RequirePackage{pgfkeys}
\RequirePackage{pgffor}
\RequirePackage{newfloat}

% =========================================================
% 0. GLOBAL DEFAULT PARAMETERS (USER CONFIGURATION STATE)
% =========================================================
% These are fallback values always defined in TeX.
% They are overwritten via pgfkeys (/ba setup layer).
% =========================================================

\newcommand{\ba@region@scale}{1.25}
\newcommand{\ba@region@radius}{6}
\newcommand{\ba@caption@style}{\scriptsize}
\newcommand{\ba@figure@scale}{0.25}
\newcommand{\ba@caption@shift}{-3mm}   % default vertical spacing
\newcommand{\ba@caption@label}{roman} % alpha | roman | arabic

% counters for captions + labeling
\newcounter{baRegionCaption}
\newcounter{baRegion}

% =========================================================
% 1. PGFKEYS SYSTEM (USER CONFIGURATION INTERFACE)
% =========================================================

\pgfkeys{
  /ba/internal/.is family,
  /ba/internal,
  region colors/.store in=\ba@colors,
  region caption/.store in=\ba@caption
}

% --- main configuration family ---
\pgfkeys{
  /ba/.is family,
  /ba,
  region scale/.code   = {\renewcommand{\ba@region@scale}{#1}},
  region radius/.code  = {\renewcommand{\ba@region@radius}{#1}},
  caption style/.code  = {\renewcommand{\ba@caption@style}{#1}},
  figure scale/.code   = {\renewcommand{\ba@figure@scale}{#1}},
  caption shift/.code  = {\renewcommand{\ba@caption@shift}{#1}},
  caption label/.code  = {\renewcommand{\ba@caption@label}{#1}}
}

\pgfkeys{
  /ba/caption label/.is choice,
  /ba/caption label/alpha/.code  = {\def\ba@caption@labelcmd{(\alph{baRegionCaption})}},
  /ba/caption label/roman/.code  = {\def\ba@caption@labelcmd{(\roman{baRegionCaption})}},
  /ba/caption label/Roman/.code  = {\def\ba@caption@labelcmd{(\Roman{baRegionCaption})}},
  /ba/caption label/arabic/.code = {\def\ba@caption@labelcmd{(\arabic{baRegionCaption})}}
}
\def\ba@fmtcaption{\alph{baRegionCaption}}
\newcommand{\baFormatCaptionLabel}{(\ba@fmtcaption)}
